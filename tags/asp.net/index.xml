&lt;li&gt;&lt;a href="https://www.acunetix.com/blog/articles/xml-external-entity-xxe-limitations/"target="_blank" rel="noopener"&gt;https://www.acunetix.com/blog/articles/xml-external-entity-xxe-limitations/&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href="https://docs.microsoft.com/en-us/previous-versions/dotnet/netframework-3.5/ms256483%28v%3dvs.90%29"target="_blank" rel="noopener"&gt;https://docs.microsoft.com/en-us/previous-versions/dotnet/netframework-3.5/ms256483(v%3Dvs.90)&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;</description></item></channel></rss>